# ====== Cloudinary (이미지 호스팅, 필수) ======
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ====== Gmail SMTP (소규모 발송) ======
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=          # Google 계정 → 보안 → 앱 비밀번호 발급

# ====== NCP Cloud Outbound Mailer (대량 발송, 권장) ======
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_SENDER_ADDRESS=noreply@humancompletion.org
NCP_SENDER_NAME=전인교육학회

# ====== MailHog (로컬 테스트, compose에서 자동 설정) ======
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025
