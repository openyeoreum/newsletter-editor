{% import '_macros.html.j2' as m %}
{{ m.doc_head('전인교육학회 뉴스레터 - Magazine') }}
<body style="margin:0; padding:0; background-color:#f0f2f0; font-family:'Apple SD Gothic Neo','Malgun Gothic',sans-serif;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f0f2f0;">
  <tr><td align="center" style="padding:20px 10px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="620" class="mobile-full" style="max-width:620px; width:100%; background-color:#ffffff;">

      {{ m.header(volume, issue_date, web_view_url, org_name, org_subtitle, org_url) }}
      {{ m.greeting_banner(greeting) }}

      <tr><td style="padding:0 40px 16px;" class="mobile-padding">
        <div style="font-size:11px; color:#1a6b4a; letter-spacing:3px; font-weight:800;">THIS ISSUE</div>
        <div style="border-top:2px solid #1a1a1a; margin-top:6px;">&nbsp;</div>
      </td></tr>

      {# Magazine: 첫 기사는 와이드, 나머지 4개는 2x2 그리드 #}
      {% set first = articles[0] %}
      <tr><td style="padding:0 40px 32px;" class="mobile-padding">
        <a href="{{ first.link }}" style="text-decoration:none;"><img src="{{ first.image }}" data-img="article-0" alt="{{ first.title }}" width="540" style="width:100%; height:auto; display:block; border-radius:10px;" class="mobile-img"></a>
        <div style="padding:18px 0 6px;">{{ m.badge(first.badge_text, '#1a6b4a', '#e8f0ec', 'articles.0.badge_text') }}</div>
        <div style="color:#1a1a1a; font-size:26px; font-weight:800; line-height:1.3; letter-spacing:-0.5px; padding-top:6px;"><a href="{{ first.link }}" style="color:inherit; text-decoration:none;"><span data-field="articles.0.title">{{ first.title }}</span></a></div>
        <div style="color:#555; font-size:15px; line-height:1.75; padding-top:10px;"><span data-field="articles.0.summary">{{ first.summary | replace('
','<br>') | safe }}</span></div>
        <div style="padding-top:14px;">
          <a href="{{ first.link }}" style="display:inline-block; background-color:#1a6b4a; color:#fff; font-size:13px; font-weight:700; text-decoration:none; padding:10px 22px; border-radius:4px;">내용 전체 읽기 &rarr;</a>
        </div>
      </td></tr>

      <tr><td style="padding:0 40px 24px;" class="mobile-padding"><div style="border-top:1px solid #e5e5e5;">&nbsp;</div></td></tr>

      {# 2x2 그리드 — 기사 2,3,4 (article 5는 별도 tall 레이아웃) #}
      <tr><td style="padding:0 40px;" class="mobile-padding">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
          {% for row in [[1,2],[3,-1]] %}
          <tr>
            {% for idx in row %}
              {% if idx >= 0 and idx < articles|length %}
              {% set a = articles[idx] %}
              <td width="50%" class="mobile-stack" style="vertical-align:top; padding:0 {% if loop.first %}10px 28px 0{% else %}0 28px 10px{% endif %};">
                <a href="{{ a.link }}" style="text-decoration:none;"><img src="{{ a.image }}" data-img="article-{{ idx }}" alt="{{ a.title }}" width="250" style="width:100%; height:160px; display:block; object-fit:cover; border-radius:10px;" class="mobile-img"></a>
                <div style="padding-top:12px;">{{ m.badge(a.badge_text, '#1a6b4a', '#e8f0ec', 'articles.' ~ idx ~ '.badge_text') }}</div>
                <div style="padding-top:8px; color:#1a1a1a; font-size:16px; font-weight:700; line-height:1.4;"><a href="{{ a.link }}" style="color:inherit; text-decoration:none;"><span data-field="articles.{{ idx }}.title">{{ a.title }}</span></a></div>
                <div style="padding-top:6px; color:#777; font-size:13px; line-height:1.6;"><span data-field="articles.{{ idx }}.summary">{{ a.summary | replace('
','<br>') | safe }}</span></div>
                <div style="padding-top:8px;"><a href="{{ a.link }}" style="color:#1a6b4a; font-size:12px; font-weight:600; text-decoration:none;">자세히 &rarr;</a></div>
              </td>
              {% else %}
              <td width="50%" class="mobile-hide">&nbsp;</td>
              {% endif %}
            {% endfor %}
          </tr>
          {% endfor %}
        </table>
      </td></tr>

      {# 5번째 아티클: 세로 이미지 + 좌측 image-left tall #}
      {% if articles|length > 4 %}
      {% set a = articles[4] %}
      <tr><td style="padding:24px 40px 0;" class="mobile-padding">
        <div style="border-top:1px solid #e5e5e5; padding-top:24px;"></div>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr>
          <td width="160" class="mobile-stack" style="vertical-align:top;">
            <a href="{{ a.link }}" style="text-decoration:none;"><img src="{{ a.image }}" data-img="article-4" alt="{{ a.title }}" width="160" style="width:160px; height:220px; display:block; object-fit:cover; border-radius:10px;" class="mobile-img-tall"></a>
          </td>
          <td width="20" class="mobile-hide">&nbsp;</td>
          <td class="mobile-stack" style="vertical-align:top;">
            {{ m.badge(a.badge_text, '#1a6b4a', '#e8f0ec', 'articles.4.badge_text') }}
            <div style="padding-top:10px; color:#1a1a1a; font-size:18px; font-weight:700; line-height:1.4;"><a href="{{ a.link }}" style="color:inherit; text-decoration:none;"><span data-field="articles.4.title">{{ a.title }}</span></a></div>
            <div style="padding-top:8px; color:#777; font-size:14px; line-height:1.65;"><span data-field="articles.4.summary">{{ a.summary | replace('
','<br>') | safe }}</span></div>
            <div style="padding-top:12px;"><a href="{{ a.link }}" style="color:#1a6b4a; font-size:13px; font-weight:600; text-decoration:none;">자세히 보기 &rarr;</a></div>
          </td>
        </tr></table>
      </td></tr>
      {% endif %}

      <tr><td style="padding:24px 0 0; font-size:0;">&nbsp;</td></tr>
      {{ m.footer(footer, web_view_url) }}
    </table>
  </td></tr>
</table>
</body>
</html>
